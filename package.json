  "author": "NOXUZ",
  "main": "desktop/main-next43.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "node scripts/build-preview.cjs --target nsis",
    "dist:portable": "node scripts/build-preview.cjs --target portable",
    "test:management": "electron test/management-ui-smoke.cjs",
    "start:preview": "electron .",
    "check:release-config": "node scripts/export-preview-config.cjs --check",
    "config:preview": "node scripts/export-preview-config.cjs",
    "check:types": "npm --prefix ui-next run check:types",
    "build:ui": "npm --prefix ui-next run build",
    "build:catalog": "npm --prefix ui-next run build-storybook",
    "dist:preview": "node scripts/build-preview.cjs",
    "test:foundation": "node --test test/store.test.cjs test/sync.test.cjs test/sync-engine.test.cjs test/access.test.cjs test/session-identity.test.cjs test/permissions.test.cjs test/backup1098.test.cjs test/backup1098-ipc.test.cjs test/reads1098.test.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.65.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "extends": "./electron-builder-preview.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
