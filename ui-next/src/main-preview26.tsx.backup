import React,{useState} from 'react';import{createRoot}from'react-dom/client';import{LayoutDashboard,ClipboardList,BookOpen,Repeat2,ShieldCheck,BarChart3,Settings2,ChevronDown,Search,Bell,Plus,ArrowUpRight,Clock3,CheckCircle2,AlertTriangle,Activity,LogOut,PanelLeftClose,PanelLeftOpen,LockKeyhole,Eye,EyeOff,Monitor,Radio,CalendarDays,FileText,Command,Shield,Menu}from'lucide-react';import*as Dialog from '@radix-ui/react-dialog';import './style.css';import './fidelity26.css';
const nav=[['Visão Geral',LayoutDashboard],['Registros',BookOpen],['Novo Registro',Plus],['Passagem de Turno',Repeat2],['Checklists',ClipboardList],['Relatórios',BarChart3],['Ferramentas',Settings2]] as const;
const events=[{id:'MOP-2408',title:'Alarme de acesso — Torre Norte',kind:'Crítico',color:'red',desc:'Ocorrência aguardando validação do supervisor.',time:'há 12 min',area:'Condomínio Alpha'},{id:'MOP-2407',title:'Verificação preventiva de câmeras',kind:'Em andamento',color:'blue',desc:'Checklist de monitoramento em execução.',time:'há 38 min',area:'Condomínio Beta'},{id:'MOP-2406',title:'Atualização de credenciais de acesso',kind:'Resolvido',color:'green',desc:'Ação concluída e registrada no livro de turno.',time:'há 1 h',area:'Condomínio Alpha'}];
function App(){const[auth,setAuth]=useState(false),[tab,setTab]=useState('Visão Geral'),[collapsed,setCollapsed]=useState(false),[tools,setTools]=useState(false),[query,setQuery]=useState(''),[notify,setNotify]=useState(false),[visible,setVisible]=useState(false);
const filtered=events.filter(e=>(e.title+' '+e.id+' '+e.area).toLowerCase().includes(query.toLowerCase()));
return !auth?<div className="login-shell"><div className="orb orb-a"/><div className="orb orb-b"/><div className="login-wrap"><div className="login-brand"><span className="brand-emblem"><Shield size={28}/></span><span><b>MOP</b><small>MONITORAMENTO OPERACIONAL</small></span></div><div className="login-card"><div className="login-symbol"><LockKeyhole size={24}/></div><span className="eyebrow">AMBIENTE EXPERIMENTAL</span><h1>Bem-vindo ao MOP</h1><p>Uma nova experiência para a sua central de operações.</p><form onSubmit={e=>{e.preventDefault();setAuth(true)}}><label>Usuário de demonstração<input value="operador.demo" readOnly aria-label="Usuário de demonstração"/></label><label>Senha de demonstração<div className="password-wrap"><input type={visible?'text':'password'} value="preview25" readOnly aria-label="Senha de demonstração"/><button type="button" onClick={()=>setVisible(!visible)} aria-label="Mostrar ou ocultar senha">{visible?<EyeOff size={17}/>:<Eye size={17}/>}</button></div></label><button className="btn-primary login-action" type="submit">Entrar na demonstração <ArrowUpRight size={17}/></button></form><p className="demo-note"><ShieldCheck size={15}/> Protótipo visual isolado. Nenhuma operação real será executada.</p></div><span className="login-footer">NOXUZ · PREVIEW 2.3.0.26 · INTERFACE NEXT</span></div></div>:<div className={'app-shell '+(collapsed?'collapsed':'')}><aside className="sidebar"><div className="brand"><span className="brand-emblem"><Shield size={22}/></span>{!collapsed&&<span className="brand-name">MOP<small>OPERATIONS PLATFORM</small></span>}<button className="collapse" onClick={()=>setCollapsed(!collapsed)} aria-label="Alternar barra lateral">{collapsed?<PanelLeftOpen size={18}/>:<PanelLeftClose size={18}/>}</button></div><div className="workspace-label">{collapsed?'•••':'WORKSPACE'}</div><div className="workspace-card"><span className="workspace-icon"><Radio size={18}/></span>{!collapsed&&<span><b>Central de operações</b><small><i/> Ambiente demonstrativo</small></span>}</div><div className="nav-caption">{!collapsed&&'NAVEGAÇÃO'}</div><nav aria-label="Menu principal">{nav.map(([name,Icon])=><button key={name} className={'nav-item '+(tab===name?'selected':'')} onClick={()=>{if(name==='Ferramentas'){setTools(!tools);return}setTab(name)}}><Icon size={19}/>{!collapsed&&<><span>{name}</span>{name==='Ferramentas'&&<ChevronDown size={15} className={tools?'rotated':''}/>}</>}</button>)}{tools&&!collapsed&&<div className="subnav"><button onClick={()=>setTab('Auditoria')}>Auditoria</button><button onClick={()=>setTab('Configurações')}>Configurações</button></div>}</nav><div className="sidebar-bottom"><div className="side-status"><span className="status-dot"/>{!collapsed&&<span><b>Interface experimental</b><small>Dados fictícios · Offline</small></span>}</div><button className="logout" onClick={()=>setAuth(false)}><LogOut size={18}/>{!collapsed&&'Sair da demonstração'}</button></div></aside><div className="app-body"><header className="topbar"><div className="breadcrumb"><span>Central operacional</span><span className="slash">/</span><strong>{tab}</strong></div><div className="top-actions"><span className="demo-pill"><span/> PREVIEW.26</span><button className="icon-button" aria-label="Notificações" onClick={()=>setNotify(true)}><Bell size={19}/><i/></button><div className="header-divider"/><div className="avatar">OD</div><div className="user-label"><b>Operador Demo</b><small>Administrador · Laboratório</small></div></div></header><main><div className="page-intro"><div><div className="eyebrow">CENTRAL OPERACIONAL <span className="eyebrow-dot"/> NOVA INTERFACE</div><h1>{tab}</h1><p>{tab==='Visão Geral'?'Uma visão clara do que importa para o seu turno.':'Prévia do módulo no novo design system. A migração operacional ocorrerá por etapas.'}</p></div><div className="page-actions"><span className="date-pill"><CalendarDays size={16}/> Demonstração visual</span><button className="btn-primary" onClick={()=>setTab('Novo Registro')}><Plus size={18}/> Novo registro</button></div></div>{tab==='Visão Geral'?<><section className="hero"><div className="hero-content"><span className="hero-kicker"><Activity size={15}/> STATUS DA OPERAÇÃO</span><h2>Seu turno, sob controle.</h2><p>Acompanhe registros, prioridades e atividades em um único lugar, com foco no que precisa da sua atenção.</p><button className="hero-button" onClick={()=>setTab('Passagem de Turno')}>Ver passagem de turno <ArrowUpRight size={17}/></button></div><div className="hero-art"><div className="hero-ring one"/><div className="hero-ring two"/><div className="hero-ring three"/><div className="hero-glow"/></div></section><section className="metrics"><div className="metric"><div className="metric-head"><span>Registros do turno</span><BookOpen size={18}/></div><div className="metric-value">24<span className="delta">+8 hoje</span></div><div className="metric-footer">Atividade registrada <ArrowUpRight size={15}/></div></div><div className="metric"><div className="metric-head"><span>Pendências abertas</span><Clock3 size={18}/></div><div className="metric-value">06<span className="delta warning">2 prioritárias</span></div><div className="metric-footer">Requerem acompanhamento <ArrowUpRight size={15}/></div></div><div className="metric"><div className="metric-head"><span>Itens resolvidos</span><CheckCircle2 size={18}/></div><div className="metric-value">18<span className="delta success">75% concluídos</span></div><div className="metric-footer">Durante este turno <ArrowUpRight size={15}/></div></div><div className="metric"><div className="metric-head"><span>Checklists</span><ClipboardList size={18}/></div><div className="metric-value">04<span className="delta">de 05 previstos</span></div><div className="metric-footer">Rotinas monitoradas <ArrowUpRight size={15}/></div></div></section><div className="content-grid"><section className="content-panel"><div className="panel-title"><div><span className="eyebrow">ACOMPANHAMENTO</span><h3>Atividade recente</h3><p>Ocorrências que merecem atenção.</p></div><button className="text-button" onClick={()=>setTab('Registros')}>Ver todos <ArrowUpRight size={16}/></button></div><div className="search-wrap"><Search size={17}/><input placeholder="Buscar registros ou condomínio..." value={query} onChange={e=>setQuery(e.target.value)} aria-label="Buscar registros"/></div><div className="event-list">{filtered.map(e=><div className="event" key={e.id}><div className={'event-icon '+e.color}>{e.color==='red'?<AlertTriangle size={19}/>:e.color==='green'?<CheckCircle2 size={19}/>:<Activity size={19}/>}</div><div className="event-main"><div className="event-top"><strong>{e.title}</strong><span className={'tag '+e.color}>{e.kind}</span></div><p>{e.desc}</p><div className="event-meta">{e.id} <span>·</span> {e.area} <span>·</span> {e.time}</div></div></div>)}{!filtered.length&&<p className="empty">Nenhum registro encontrado.</p>}</div></section><section className="right-column"><div className="content-panel shift-panel"><div className="panel-title"><div><span className="eyebrow">SEU TURNO</span><h3>Resumo operacional</h3></div><span className="live-pill"><i/> Ativo</span></div><div className="shift-time"><Clock3 size={22}/><div><b>06:00 — 18:00</b><small>Turno diurno · Exemplo</small></div></div><div className="progress-heading"><span>Rotinas concluídas</span><b>80%</b></div><div className="progress"><span/></div><button className="outline-button" onClick={()=>setTab('Passagem de Turno')}>Abrir passagem de turno <ArrowUpRight size={16}/></button></div><div className="content-panel quick-panel"><div className="panel-title"><div><span className="eyebrow">ACESSO RÁPIDO</span><h3>Ferramentas</h3></div></div><button onClick={()=>setTab('Novo Registro')}><Plus size={18}/> Criar novo registro <ArrowUpRight size={16}/></button><button onClick={()=>setTab('Checklists')}><ClipboardList size={18}/> Abrir checklists <ArrowUpRight size={16}/></button><button onClick={()=>setTab('Relatórios')}><FileText size={18}/> Consultar relatórios <ArrowUpRight size={16}/></button></div></section></div></>:<section className="placeholder"><span className="placeholder-icon"><Monitor size={29}/></span><span className="eyebrow">PREVIEW.26 · MIGRAÇÃO CONTROLADA</span><h2>{tab}</h2><p>Esta tela ainda utiliza a implementação operacional anterior. Aqui exibimos somente a estrutura visual do novo MOP, sem gravar ou alterar registros.</p><button className="btn-primary" onClick={()=>setTab('Visão Geral')}>Voltar à Visão Geral <ArrowUpRight size={17}/></button></section>}<footer>NOXUZ / MOP · UI NEXT EXPERIMENTAL <span>Interface demonstrativa · Sem conexão com dados operacionais</span></footer></main></div><Dialog.Root open={notify} onOpenChange={setNotify}><Dialog.Portal><Dialog.Overlay className="modal-overlay"/><Dialog.Content className="modal"><Dialog.Title>Notificações de demonstração</Dialog.Title><Dialog.Description>Este protótipo não acessa notificações reais.</Dialog.Description><div className="notification-line"><Bell size={18}/> Nenhuma notificação operacional conectada.</div><Dialog.Close className="btn-primary">Fechar</Dialog.Close></Dialog.Content></Dialog.Portal></Dialog.Root></div>}
createRoot(document.getElementById('root')).render(<App/>);
